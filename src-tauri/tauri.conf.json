{
  "$schema": "https://raw.githubusercontent.com/nicerbix/tauri-v2/refs/heads/v2/core/tauri-config-schema/schema.json",
  "productName": "Messenger",
  "version": "1.0.0",
  "identifier": "com.messenger.pwa.tauri",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}